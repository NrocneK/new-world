{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": null,
  "buildCommand": null,
  "outputDirectory": "site",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/downloads/(.*)",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/art/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/level-sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/downloads/di-mon-vfx-v5.zip",
      "destination": "https://github.com/NrocneK/new-world/raw/refs/heads/codex/vfx-v5-downloads/site/downloads/di-mon-vfx-v5.zip",
      "permanent": false
    },
    {
      "source": "/downloads/di-mon-vfx-v6.zip",
      "destination": "https://github.com/NrocneK/new-world/raw/refs/heads/codex/vfx-v5-downloads/site/downloads/di-mon-vfx-v6.zip",
      "permanent": false
    },
    {
      "source": "/downloads/di-mon-chapter-one.zip",
      "destination": "https://github.com/NrocneK/new-world/raw/refs/heads/codex/vfx-v5-downloads/site/downloads/di-mon-chapter-one.zip",
      "permanent": false
    }
  ]
}
